{
  "name": "@codexsun/uiux",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @codexsun/uiux-web",
    "build": "npm run build --workspace @codexsun/uiux-web",
    "typecheck": "npm run typecheck --workspace @codexsun/uiux-web",
    "lint": "npm run lint --workspace @codexsun/uiux-web",
    "check:repository": "node tools/check-repository.mjs",
    "check": "npm run tools:check && npm run check:repository && npm run typecheck",
    "verify": "npm run check && npm run lint && npm test && npm run build && npm run check:budgets",
    "version:bump": "devxcrew-tools version:bump",
    "github:now": "devxcrew-tools github:now",
    "fix:line-endings": "devxcrew-tools lines:fix",
    "test:release-tools": "node --test tools/line-endings.test.mjs tools/version-bump.test.mjs",
    "check:versions": "devxcrew-tools check:versions",
    "preinstall": "npm install --prefix ../../shared/ui",
    "version:update": "devxcrew-tools version:bump",
    "version:show": "devxcrew-tools version:show",
    "changelog:append": "devxcrew-tools changelog:append",
    "changelog:show": "devxcrew-tools changelog:show",
    "tools:lines:fix": "devxcrew-tools lines:fix",
    "lines:check": "devxcrew-tools lines:check",
    "tools:check": "devxcrew-tools dependencies:order && devxcrew-tools check:versions && devxcrew-tools lines:check",
    "mcp:connect": "node agent/connect.mjs",
    "mcp:verify": "node agent/connect.mjs --strict",
    "version-bump": "devxcrew-tools version:bump",
    "test": "tsx --test web/src/modules/gallery/*.test.ts",
    "check:budgets": "node tools/check-budgets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devxcrew/uiux.git"
  },
  "devDependencies": {
    "@devxcrew/tools": "^0.1.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
