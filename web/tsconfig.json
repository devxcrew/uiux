{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client",
      "react",
      "react-dom"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react": [
        "../../../shared/ui/node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "../../../shared/ui/node_modules/@types/react/*"
      ],
      "react-dom": [
        "../../../shared/ui/node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "../../../shared/ui/node_modules/@types/react-dom/*"
      ]
    },
    "noEmit": true,
    "jsx": "react-jsx",
    "typeRoots": [
      "../../../shared/ui/node_modules/@types",
      "../node_modules/@types",
      "node_modules/@types"
    ]
  },
  "include": [
    "src"
  ]
}
